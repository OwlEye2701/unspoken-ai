# ==============================================================================
# Unspoken AI — Environment Configuration Template
# ==============================================================================

# 1. Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only service role key (required for admin operations, owner console, and app_metadata claims)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 2. Google Gemini API (server-side only)
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.8-flash

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Payment Provider Webhooks (Test / Sandbox mode)
# Stripe Webhook Secret (used in /api/webhooks/billing?provider=stripe)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
# Razorpay Webhook Secret (used in /api/webhooks/billing?provider=razorpay)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 5. Owner Account Bootstrap (Used by scripts/bootstrap-owner.ts)
OWNER_BOOTSTRAP_EMAIL=owner@yourdomain.com
# Set to 'true' only in local development / staging environments to grant unlimited test credits
DEV_UNLIMITED_OWNER_CREDITS=false
